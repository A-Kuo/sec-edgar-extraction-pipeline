# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#   cp .env.example .env

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://sec_user:sec_pass@localhost:5432/sec_edgar

# --- Cache ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- SEC EDGAR --------------------------------------------------------------
# Required by the SEC. Requests without a User-Agent identifying your
# application and a contact email are rejected with 403.
SEC_USER_AGENT=your-app-name your.email@example.com

# Set true for local development and tests: uses fixture data instead of live
# API calls, so no network access to sec.gov is needed.
MOCK_EDGAR=true

# --- Machine learning -------------------------------------------------------
# Where versioned model artifacts live. Mounted as a volume in production so a
# model promotion does not require an image rebuild.
MODEL_REGISTRY_ROOT=models

# --- Airflow ----------------------------------------------------------------
AIRFLOW_HOME=./airflow
# Set to enable POST /trigger/{ticker} to start a real DAG run. Unset, the
# endpoint returns an informational response instead.
# AIRFLOW_API_URL=http://localhost:8080
# AIRFLOW_USER=airflow
# AIRFLOW_PASSWORD=

# --- Alerting (optional) ----------------------------------------------------
# SLACK_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=587
# ALERT_EMAIL_TO=
